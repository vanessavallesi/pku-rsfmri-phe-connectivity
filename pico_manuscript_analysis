  mutate(
    group = as.factor(group),
    sex   = as.factor(sex),
    ID    = as.factor(ID),
    Age   = as.numeric(Age),
    id_type = ifelse(grepl("PAT", ID), "PAT", "CON"),
    id_num  = as.numeric(gsub(".*-(\\d+)-.*", "\\1", ID)),
