create_correlation_plot <- function(pc_var, hist_var, data) {

  complete_data <- data %>%
    filter(!is.na(.data[[pc_var]]), !is.na(.data[[hist_var]]))

  kendall_result <- suppressWarnings(
    cor.test(complete_data[[pc_var]], complete_data[[hist_var]], method = "kendall")
  )

  x_range <- range(data[[pc_var]], na.rm = TRUE)
  y_range <- range(unlist(data[historical_vars_z]), na.rm = TRUE)

  annotation_text <- paste0(
    "Kendall's tau = ", round(kendall_result$estimate, 3), "\n",
    "p = ", round(kendall_result$p.value, 4), "\n",
    "n = ", nrow(complete_data)
  )

  ggplot(complete_data, aes(x = .data[[pc_var]], y = .data[[hist_var]])) +
    geom_point(colour = "black", alpha = 0.6, size = 3) +
    geom_smooth(
      method = "lm", se = TRUE,
      colour = "black", linewidth = 1.1,
      fill = "grey70", alpha = 0.3
    ) +
    annotate(
      "label",
      x = max(x_range) - 0.1 * diff(x_range),
      y = max(y_range) - 0.1 * diff(y_range),
      label = annotation_text,
      hjust = 1, vjust = 1, size = 4.5,
      fill = "white", alpha = 0.9, colour = "black"
    ) +
    labs(
      title = period_labels[[hist_var]],
      x = paste("Principal Component", substr(pc_var, 3, 3)),
      y = "Historical Phe (z-standardized)"
    ) +
    xlim(x_range) +
    ylim(y_range) +
    theme_classic(base_size = 18) +
    theme(
      axis.title = element_text(size = 14),
      axis.text = element_text(size = 12),
      plot.title = element_text(hjust = 0.5, face = "bold", size = 16)
    )
}

build_supplementary_figure <- function(pc_var, data) {
  plots <- lapply(historical_vars_z, function(v) create_correlation_plot(pc_var, v, data))
  wrap_plots(plots, ncol = 3) +
    plot_annotation(tag_levels = "A") &
    theme(plot.tag = element_text(size = 18, face = "bold"))
}

