############################################################
# PICO resting-state fMRI manuscript analyses
#
# This script reproduces the R-based statistical analyses
# reported in the manuscript.
#
# Data are not included in this repository due to ethical
# and data protection restrictions.
############################################################


############################################################
# 1. Packages
############################################################

library(tidyverse)
library(robustbase)
library(ggeffects)
library(pheatmap)
library(patchwork)


############################################################
# 2. Load data
############################################################

FC       <- read.csv("data/FC_results.csv")
GCOR     <- read.csv("data/GCOR_values.csv")
cog      <- read.csv2("data/data_pico_cognition_mood_concurrentPhe.csv")
phe      <- read.csv("data/Phe_pat.csv")
trp      <- read.csv("data/trp_pat.csv")
tyr      <- read.csv("data/tyr_pat.csv")
hist_phe <- read.csv("data/Data_PICO_historical_Phe.csv")


############################################################
# 3. Prepare data
############################################################

cog <- cog %>%
  mutate(
    group = as.factor(group),
    sex   = as.factor(sex),
    ID    = as.factor(ID),
    Age   = as.numeric(Age),
    id_type = ifelse(grepl("PAT", ID), "PAT", "CON"),
    id_num  = as.numeric(gsub(".*-(\\d+)-.*", "\\1", ID)),
    id_type = factor(id_type, levels = c("PAT", "CON"))
  ) %>%
  arrange(id_type, id_num) %>%
  select(-id_type, -id_num)

# Add CONN_ID according to CONN project order
cog$CONN_ID  <- seq_len(nrow(cog))
FC$CONN_ID   <- seq_len(nrow(FC))
GCOR$CONN_ID <- seq_len(nrow(GCOR))
phe$CONN_ID  <- seq_len(nrow(phe))
trp$CONN_ID  <- seq_len(nrow(trp))
tyr$CONN_ID  <- seq_len(nrow(tyr))

data <- cog %>%
  full_join(FC, by = "CONN_ID") %>%
  full_join(GCOR, by = "CONN_ID") %>%
  full_join(phe, by = "CONN_ID") %>%
  full_join(trp, by = "CONN_ID") %>%
  full_join(tyr, by = "CONN_ID")

# Exclude participants after quality control:
# excessive motion artefacts n = 2; anatomical anomaly n = 1
data <- data %>%
  filter(!CONN_ID %in% c(17, 29, 75))

# Recode variables
data <- data %>%
  mutate(
    sex = factor(sex),
    group_numeric = as.numeric(group) - 1,
    group_label = ifelse(group_numeric == 1, "PKU", "HC"),
    group_label = factor(group_label, levels = c("PKU", "HC"))
  )

############################################################
# 4. Participant characteristics / Table 1
############################################################

cluster_vars <- grep("^cluster", names(data), value = TRUE)

data_fc <- data %>%
  filter(rowSums(!is.na(select(., all_of(cluster_vars)))) > 0)

table(data_fc$group_label)

format_median_iqr_range <- function(x) {
  x <- x[!is.na(x)]
  paste0(
    round(median(x), 2), " (",
    round(IQR(x), 2), "; ",
    round(min(x), 2), " - ",
    round(max(x), 2), ")"
  )
}

