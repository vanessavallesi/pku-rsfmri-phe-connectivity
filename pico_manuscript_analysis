iq_sensitivity_results <- map_dfr(fc_cluster_vars, function(var) {
  
  model_original <- lm(
    as.formula(paste(var, "~ group_numeric + Age + sex")),
    data = data_fc
  )
  
  model_iq <- lm(
    as.formula(paste(var, "~ group_numeric + Age + sex + wasi_iq")),
    data = data_fc
  )
  
  beta_original <- summary(model_original)$coefficients["group_numeric", "Estimate"]
  beta_iq       <- summary(model_iq)$coefficients["group_numeric", "Estimate"]
  
  tibble(
    cluster = var,
    beta_original = beta_original,
    beta_IQ = beta_iq,
    delta_beta = beta_iq - beta_original,
    percent_change = 100 * (beta_iq - beta_original) / abs(beta_original)
  )
})

iq_sensitivity_results
