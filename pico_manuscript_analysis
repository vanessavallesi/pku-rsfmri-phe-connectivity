run_kendall <- function(pc_var, hist_vars, data) {
  map_dfr(hist_vars, function(hist_var) {
    complete_data <- data %>%
      filter(!is.na(.data[[pc_var]]), !is.na(.data[[hist_var]]))
    
    if (nrow(complete_data) < 3) {
      return(tibble(
        PC = pc_var,
        Period = hist_var,
        N = nrow(complete_data),
        Kendall_tau = NA_real_,
        P_Value = NA_real_
      ))
    }
    
    test <- cor.test(
      complete_data[[pc_var]],
      complete_data[[hist_var]],
      method = "kendall"
    )
    
    tibble(
      PC = pc_var,
      Period = hist_var,
      N = nrow(complete_data),
      Kendall_tau = unname(test$estimate),
      P_Value = test$p.value
    )
  })
}

