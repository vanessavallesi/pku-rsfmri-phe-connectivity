fc_cluster_vars <- c(
  "cluster..52..14..20..rest1_DorsalAttention.IPS.l",
  "cluster..56..14..6..rest1_DorsalAttention.IPS.l",
  "cluster..2..68..20..rest1_DorsalAttention.IPS.r",
  "cluster..54..14..4..rest1_DorsalAttention.IPS.r",
  "cluster..52..14..18..rest1_DorsalAttention.IPS.r",
  "cluster..30..56..8..rest1_FrontoParietal.LPFC.l",
  "cluster..18..8..62..rest1_FrontoParietal.LPFC.l",
  "cluster..rest1_FrontoParietal.LPFC.r",
  "cluster..rest1_LocalCorrelation_1"
)

cluster_data_complete <- pat %>%
  select(all_of(fc_cluster_vars)) %>%
  drop_na()

pca <- prcomp(cluster_data_complete, scale. = TRUE)

eigenvalues <- pca$sdev^2
prop_var <- eigenvalues / sum(eigenvalues)
cum_var <- cumsum(prop_var)

pca_results <- tibble(
  PC = paste0("PC", seq_along(eigenvalues)),
  Eigenvalue = eigenvalues,
  ProportionVar = prop_var,
  CumulativeVar = cum_var
)

pca_results

# Add PC scores to patient dataset
complete_rows <- complete.cases(pat[, fc_cluster_vars])

